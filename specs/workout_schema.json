{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkoutSpec",
  "type": "object",
  "properties": {
    "title": { "type": "string" },
    "activity_type": {
      "type": "string",
      "enum": ["trail_walk", "fartlek_run", "rucking", "interval_sprints"]
    },
    "target_duration_minutes": { "type": "integer", "minimum": 5, "maximum": 180 },
    "terrain_suggestion": { "type": "string" },
    "blocks": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "phase": { "type": "string", "enum": ["warmup", "main_set", "cooldown"] },
          "duration_minutes": { "type": "integer", "minimum": 1 },
          "instruction": { "type": "string" },
          "target_rpe_1_to_10": { "type": "integer", "minimum": 1, "maximum": 10 }
        },
        "required": ["phase", "duration_minutes", "instruction", "target_rpe_1_to_10"]
      }
    }
  },
  "required": [
    "title",
    "activity_type",
    "target_duration_minutes",
    "terrain_suggestion",
    "blocks"
  ]
}
